# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
*.whl

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ─── PyInstaller Build Artifacts ────────────────────────
dist/
build/
*.manifest
# Note: build.spec and translator.spec are tracked in git for reproducible builds!

# ─── Executables & Binary Artifacts ─────────────────────
*.exe

# ─── Virtual Environments & Secrets ─────────────────────
venv/
.venv/
env/
.env/
.env
.env.*
!.env.example
*.pem
*.key

# ─── IDE / Editors ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ─── OS files ────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# ─── Project-specific ───────────────────────────────────
# Translation / OCR cache (keep folder, ignore DB & contents)
cache/*
!cache/__init__.py
!cache/store.py

# Captured screenshots
screenshots/

# Tesseract temp output
*.tiff
*.tif

# Logs
logs/
*.log

# Test execution outputs
tests/output.txt
tests/*.txt

# User settings (generated at runtime)
settings.json

# Local databases (translation cache, history) — contain captured screen text
*.db
*.sqlite
*.sqlite3

# Layered build deps cache (2.1)
_build_cache/
dist/TranslatorOverlay_deps/

# Claude Code workspace (local notes, project map, rtk instructions)
.claude/

# AI assistant files (Claude): instructions, skills, local notes, scratch
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.agents/
.skills/
skills/
.mcp.json
scratch/

# RTK (Rust Token Killer) local config
.rtk/

# Local ML models (NLLB checkpoints, CTranslate2 builds) — never committed
models/
*.ct2/

# Hugging Face download cache (used when converting the NLLB checkpoint)
.hf-cache/

# Exported datasets (contain captured screen text — user data)
data/

# Training environment (CUDA torch) and its pip/HF/temp caches — kept on this drive
.venv-train/
.train-cache/

# LoRA checkpoints and training runs
checkpoints/
