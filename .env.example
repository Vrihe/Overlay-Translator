# ─── API Keys (Choose one) ──────────────────────────────

# For free models via OpenRouter (recommended for free usage)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OR for Anthropic directly (paid)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Other translation backends (optional) ─────────────
# Google works without a key; a Cloud Translation key switches to the official API.
# GOOGLE_API_KEY=
# DEEPL_API_KEY=
# AZURE_API_KEY=

# Hotkey, languages, backend, OCR languages and popup timeout are set in the
# Settings window (stored in %APPDATA%\translator-overlay\settings.json).

# ─── Hotkey ─────────────────────────────────────────────
# SETTINGS_HOTKEY=ctrl+shift+o

# ─── OCR (RapidOCR; EASYOCR_* names kept for old .env files) ──
# EASYOCR_GPU=auto
# EASYOCR_CONFIDENCE_THRESHOLD=0.25

# ─── Local NLLB model ───────────────────────────────────
# NLLB_MODEL_DIR=
# NLLB_DEVICE=auto

# ─── Logging ────────────────────────────────────────────
# 1 = write the first 80 characters of translated text to the logs (debugging only)
# OVERLAY_LOG_TEXT=0
