# Local NLLB inference service (service/, roadmap stage 11) for demos and a server scenario.
# CPU image: the model runs as CTranslate2 int8. The model is NOT baked in: mount a build directory
# and point NLLB_MODEL_DIR at it (docker-compose.yml does both). Download one with
# scripts/download_model.py on the host first; the container never goes to the network.
#
#   docker build -f Dockerfile.service -t overlay-translator-service .
#   docker run --rm -p 127.0.0.1:8765:8765 -v ./models/nllb-200-ct2-int8:/models/nllb:ro overlay-translator-service
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NLLB_MODEL_DIR=/models/nllb

WORKDIR /app

# Runtime of the local backend (same pins as requirements.txt) + the service extras.
COPY requirements-service.txt ./
RUN pip install --no-cache-dir "ctranslate2>=4.5.0" "sentencepiece>=0.2.0" "langid>=1.1.6" \
        "python-dotenv>=1.0.1" -r requirements-service.txt

# Only what service.app imports: no UI, no training, no models.
COPY config.py ./
COPY settings/ settings/
COPY cache/ cache/
COPY i18n/ i18n/
COPY translate/ translate/
COPY service/ service/

# Not root; the SQLite history of the backend goes to a throwaway directory.
RUN useradd --create-home app
USER app

EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=4).status == 200 else 1)"

# 0.0.0.0 inside the container only; compose publishes the port on the host loopback.
CMD ["python", "-m", "service", "--host", "0.0.0.0", "--port", "8765"]
